{
  "name": "lab-orders-lite",
  "version": "0.0.0",
  "private": true,
  "description": "A small clinic app for patients, a lab test catalog and orders.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env src/server/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/cli.ts migrate",
    "db:reset": "tsx --env-file-if-exists=.env src/server/db/cli.ts reset && tsx --env-file-if-exists=.env db/seed.ts",
    "db:seed": "tsx --env-file-if-exists=.env db/seed.ts",
    "db:test:reset": "tsx --env-file-if-exists=.env src/server/db/cli.ts test-reset"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  }
}
