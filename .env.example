# Postgres connection string for the development database.
DATABASE_URL=postgres://lab_orders:lab_orders@localhost:5433/lab_orders
# Postgres connection string for the test database; its name must end in _test.
TEST_DATABASE_URL=postgres://lab_orders:lab_orders@localhost:5433/lab_orders_test
# Port the API server listens on.
PORT=3000
# Port the web app (Vite) listens on; it must differ from PORT.
WEB_PORT=5173
# Host port of the Docker database; DATABASE_URL and TEST_DATABASE_URL must use the same port.
DB_PORT=5433
# Docker Compose project name: each copy of the project needs its own, so it gets its own container and data volume.
COMPOSE_PROJECT_NAME=lab-orders-lite
# How much the server logs: debug, info, warn or error.
LOG_LEVEL=info
# The clinic's time zone (IANA name), used to decide what "today" is for ready dates.
CLINIC_TIMEZONE=America/Denver
